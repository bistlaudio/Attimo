extends RefCounted
## MOVE-10 / T-02-19: docs/MOVEMENT-METRICS.md exists, lists every required row and its config snapshot equals
## movement_default.tres. A retuned resource without a regenerated table fails here. Read-only: this test writes nothing.
## Regenerate with: bash attimo/tests/run.sh --tool res://tools/measure_movement.gd

## Fixed read-only path, relative to the project root (attimo/); same idiom as test_conventions.
const DOC_RELATIVE_PATH: String = "../docs/MOVEMENT-METRICS.md"
const CONFIG_PATH: String = "res://resources/player/movement_default.tres"
const REGENERATE_HINT: String = "re-run `bash attimo/tests/run.sh --tool res://tools/measure_movement.gd`"
## Row labels the doc contract requires (the first cell of a table row).
const ROW_LABELS: Array[String] = [
	"Run speed", "Tap jump", "Full jump (standing)", "Full jump (run)",
	"Jump 2 (chain)", "Jump 3 (salto)", "Ground dash", "Air dash",
	"Long jump stage 1", "Long jump stage 2", "Long jump stage 3", "Long jump stage 1 (after stage 3)", "Long jump (last grace tick)",
	"Coyote time", "Jump buffer", "Landing window", "Dash cooldown", "Dash-jump grace",
	"Step 0.15 m", "Step 0.20 m",
	"Latency jump 60 TPS", "Latency jump 120 TPS", "Latency dash 60 TPS", "Latency dash 120 TPS",
]


func run(_tree: SceneTree, check: Callable) -> void:
	var doc_path: String = ProjectSettings.globalize_path("res://").path_join(DOC_RELATIVE_PATH).simplify_path()
	check.call(FileAccess.file_exists(doc_path), "docs/MOVEMENT-METRICS.md exists (%s); %s" % [doc_path, REGENERATE_HINT])
	var doc: String = FileAccess.get_file_as_string(doc_path)
	check.call(doc.length() > 0, "docs/MOVEMENT-METRICS.md is readable and not empty")
	check.call(doc.begins_with("# Movement Metrics"), "the doc starts with '# Movement Metrics'")
	check.call(doc.contains("Generated by tools/measure_movement.gd"), "the doc names its generator (Generated by tools/measure_movement.gd)")
	check.call(doc.contains("## Config snapshot"), "the doc has a '## Config snapshot' section")
	check.call(doc.contains("outside the software measurement"), "the doc states that display, compositor and USB latency are outside the software measurement (D-22)")
	for label: String in ROW_LABELS:
		check.call(doc.contains("| %s |" % label), "the doc has the row '%s'" % label)
	_check_snapshot(doc, check)


## Every editor-visible float of the tuned resource must appear as a snapshot row with its current value.
func _check_snapshot(doc: String, check: Callable) -> void:
	var config: MovementConfig = load(CONFIG_PATH) as MovementConfig
	check.call(config != null, "%s loads as a MovementConfig" % CONFIG_PATH)
	if config == null:
		return
	var fields: int = 0
	for info: Dictionary in config.get_property_list():
		if int(info["type"]) != TYPE_FLOAT or (int(info["usage"]) & PROPERTY_USAGE_EDITOR) == 0:
			continue
		fields += 1
		var field: String = str(info["name"])
		var row: String = "| `%s` | %.3f |" % [field, float(config.get(field))]
		check.call(doc.contains(row), "config snapshot row %s matches movement_default.tres; %s if it was retuned" % [row, REGENERATE_HINT])
	check.call(fields >= 30, "the resource exposes at least 30 float fields to snapshot (got %d)" % fields)
